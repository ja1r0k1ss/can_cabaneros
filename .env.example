# Copy to .env.local (gitignored) for `npm run dev`; in Vercel set them under Project → Settings → Environment Variables.
# Free speech-to-text (Whisper large-v3 on Groq): https://console.groq.com/keys
GROQ_API_KEY=
# Optional, paid (~0,03 $ per import): merges description + comments + transcript with Claude. Without it a free rule-based parser is used.
ANTHROPIC_API_KEY=
